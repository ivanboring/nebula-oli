#!/usr/bin/env bash
## Description: Run the canvas-migration eval harness inside the abp-eval referee service (grade, list, view, web, show, export)
## Usage: eval [ABP_VAR=value ...] [grade|list|view|web|show|export] [args]
## Example: "ddev eval grade"
## ExecRaw: true

# This runs INSIDE the abp-eval service - the referee container promoted to
# a ddev service by .ddev/docker-compose.abp-eval.yaml (generated by
# .drupalaibp/setup-evals.sh). Python, node, chromium, agent-browser and a
# docker CLI are baked into the image; the project is mounted read-only at
# its host path (.abp-eval/ and the instrument's runs/ writable), and
# container-sandbox checks reach the web container through the docker
# socket. Only this service holds the socket - the web container, where the
# graded agent works, never does, and the eval tree is masked from it.
#
# Ported from freelygive/canvas-storybook-ai (.ddev/commands/abp-eval/eval);
# the Nebula bed differs only in how it is armed (no local Drupal, no
# storybook: `abp-eval nebula`, see .drupalaibp/evals/NEBULA-ARM.md).
set -euo pipefail

# Compose provides ABP_PROJECT_DIR and ABP_EVAL_DIR; refuse a foreign
# environment loudly rather than grade the wrong plane.
: "${ABP_PROJECT_DIR:?abp-eval service misconfigured: ABP_PROJECT_DIR unset (regenerate: bash .drupalaibp/setup-evals.sh on the host)}"
: "${ABP_EVAL_DIR:?abp-eval service misconfigured: ABP_EVAL_DIR unset (regenerate: bash .drupalaibp/setup-evals.sh on the host)}"
FRONT="$ABP_EVAL_DIR/abp-eval"
if [ ! -x "$FRONT" ]; then
  echo "eval: instrument not found at $ABP_EVAL_DIR" >&2
  echo "  on the host, run: bash .drupalaibp/setup-evals.sh  (then ddev restart)" >&2
  exit 1
fi

# The image runs unprivileged with HOME pointed at tmpfs; the instrument is
# a git checkout owned by the host user, so mark it safe for the manifest's
# git calls (abp_git_sha + dirty flag).
mkdir -p "$HOME"
git config --global --add safe.directory '*' 2>/dev/null || true

# `ddev exec` does not forward host shell environment, so operator
# overrides travel as leading VAR=VALUE arguments instead:
#   ddev eval ABP_PAGE_STORY_ID=pages-home--default grade
while [ $# -gt 0 ] && printf '%s' "$1" | grep -qE '^ABP_[A-Z_]+=.'; do
  export "${1?}"; shift
done

# The freelygive homepage set (custom/canvas-migration, shared with the
# canvas-storybook kit so the two kits grade the same cases) was calibrated
# on a bed named fg-canvas-eval; its dataset embeds those hosts and run
# group. The instrument's bed profile projects them onto THIS bed at grade
# time - these exports only declare what the dataset embeds, they do not
# name this project. A different custom set overrides them in its own wrapper.
export ABP_CANONICAL_HOST="${ABP_CANONICAL_HOST:-fg-canvas-eval.ddev.site}"
export ABP_CANONICAL_STORYBOOK_HOST="${ABP_CANONICAL_STORYBOOK_HOST:-storybook.fg-canvas-eval.ddev.site}"
export ABP_RUN_GROUP="${ABP_RUN_GROUP:-fg-homepage-e2e}"
export ABP_SOURCE_SITE="${ABP_SOURCE_SITE:-https://freelygive.io/}"

# `referee` is this command now - grading here IS the referee plane.
if [ "${1:-}" = "referee" ]; then
  echo "eval: this command already grades inside the referee service - running 'grade'."
  shift
  set -- grade "$@"
fi

case "${1:-}" in
  run|reset|nebula)
    # Grade-only by design (see the referee Dockerfile's threat model): the
    # agentic (paid) run stays host-driven - it needs the ddev CLI and the
    # operator attestation this container does not carry. On this kit the
    # arm-and-launch front door is `abp-eval nebula`; there is no in-place
    # reset (a new episode is a fresh install, see NEBULA-ARM.md).
    echo "eval: '$1' is host-driven - from the project root on the host, run:" >&2
    echo "  $ABP_EVAL_DIR/abp-eval nebula -p . --env <handover-env-file> --source-url $ABP_SOURCE_SITE [--reset-verified]" >&2
    echo "  (see .drupalaibp/evals/NEBULA-ARM.md)" >&2
    exit 2
    ;;
  grade)
    # Grading gates on the arming evidence (.abp-eval/state.json). On this
    # kit nebula-prep.sh seeds it from the operator's credential file - the
    # install cannot do that, and this container cannot drive ddev.
    if [ ! -f "$ABP_PROJECT_DIR/.abp-eval/state.json" ]; then
      echo "eval: bed not armed (no .abp-eval/state.json)" >&2
      echo "  on the host, from the project root, run:" >&2
      echo "  $ABP_EVAL_DIR/abp-eval nebula -p . --env <handover-env-file> --source-url $ABP_SOURCE_SITE" >&2
      echo "  (the five-key credential file is the operator handover: .drupalaibp/evals/NEBULA-ARM.md)" >&2
      exit 1
    fi
    ;;
esac

# The viewer must bind all interfaces to be reachable through the ddev
# router (its default is 127.0.0.1, container-local), and its own URL
# message only knows the bind address - print the router URL instead.
if [ "${1:-}" = "web" ]; then
  has_host=false; port=8899; prev=""
  for a in "$@"; do
    [ "$a" = "--host" ] && has_host=true
    [ "$prev" = "--port" ] && port="$a"
    prev="$a"
  done
  $has_host || set -- "$@" --host 0.0.0.0
  if [ -n "${ABP_WEB_URL:-}" ]; then
    if [ "$port" = "8899" ]; then
      echo "eval: viewer reachable from the host at ${ABP_WEB_URL} (ddev router)"
    else
      echo "eval: note - the ddev router passthrough serves container port 8899;"
      echo "      --port $port is reachable in-container only"
    fi
  fi
fi

# Per-bed grade lock, referee doctrine: the checks share one agent-browser
# daemon and mutate .abp-eval staging, so parallel grades produce garbage.
# /tmp is this container's own namespace - one service per bed by
# construction, so a static lock file covers every invocation path.
if command -v flock >/dev/null 2>&1; then
  exec 9> /tmp/abp-eval-grade.lock
  case "${1:-}" in
    grade) flock -n 9 || { echo "eval: another grade is already running for this bed" >&2; exit 1; } ;;
  esac
fi

exec "$FRONT" "$@"
